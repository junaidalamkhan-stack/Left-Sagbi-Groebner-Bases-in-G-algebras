// Example 3.14: syzygy family SyzFam(g1, g2) over S (syzfam).
option(noredefine);
LIB "ncsg.lib";
ring R = 0, (x, d), dp;
matrix C[2][2]; C[1,2] = 1;
matrix D[2][2]; D[1,2] = 1;                 // d*x = x*d + 1
def A1 = nc_algebra(C, D);                  // first Weyl algebra
setring A1;
ideal H_sub = x^2, x*d, d^2;                // Sagbi basis of S
poly g1 = x^4*d^2;
poly g2 = x^3*d^3 + 3*x^2*d^2 + x*d;
syzfam(g1, g2, H_sub);
quit;

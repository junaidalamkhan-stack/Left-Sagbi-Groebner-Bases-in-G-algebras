// Examples 3.8 and 3.9: final left SG-reductum (Algorithm 1, lsgred).
option(noredefine);
LIB "ncsg.lib";

"Example 3.8 (A_1, lex x > d)";
ring R = 0, (x, d), lp;
matrix C[2][2]; C[1,2] = 1;
matrix D[2][2]; D[1,2] = 1;                 // d*x = x*d + 1
def A1 = nc_algebra(C, D);                  // first Weyl algebra
setring A1;
ideal H = x^2, x*d, d^2;                    // Sagbi basis of S
ideal G = x^2*d^2, x^2 + x*d, x^3*d^3 + 3*x^2*d^2 + x*d;
poly p = x^3*d^5 + x*d^3;
H[2]*H[3]*G[1];                             // f2*f3*g1
lsgred(p, H, G);                            // 19xd3+12d2 (Table 1)

"Example 3.9 (U(sl_2), dp)";
ring R = 0, (e, f, h), dp;
matrix C[3][3]; C[1,2]=1; C[1,3]=1; C[2,3]=1;
matrix D[3][3]; D[1,2]=-h; D[1,3]=2*e; D[2,3]=-2*f;
def Usl2 = nc_algebra(C, D);                // U(sl_2): f*e = e*f - h, h*e = e*h + 2e, h*f = f*h - 2f
setring Usl2;
ideal H = e, h;
ideal G = e^2 + h, e*h;
poly p = e^3 + e*h + h^2;
lsgred(p, H, G);                            // h2
quit;

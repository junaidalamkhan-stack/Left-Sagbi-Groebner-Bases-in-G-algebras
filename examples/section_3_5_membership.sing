// Section 3.5: ideal membership in the algebra of even-order differential
// operators S = Q<x^2, xd, d^2> (the fixed ring of x -> -x, d -> -d).
option(noredefine);
LIB "ncsg.lib";
ring R = 0, (x, d), lp;
matrix C[2][2]; C[1,2] = 1;
matrix D[2][2]; D[1,2] = 1;                 // d*x = x*d + 1
def A1 = nc_algebra(C, D);                  // first Weyl algebra
setring A1;
ideal H_sub = x^2, x*d, d^2;
ideal G_ideal = x^4*d^2, x^3*d^3 + 3*x^2*d^2 + x*d;
ideal SG = lsgb(G_ideal, H_sub, 10);        // left SG-basis of J (Example 3.20)
poly P = (x*d)^4;
P;                                          // equation (7)
lsgred(P, H_sub, SG);                       // 0, so P lies in J
P - (H_sub[3]*SG[1] - 2*SG[2] + SG[3]);     // identity (8): (xd)^4 = f3*g1 - 2*g2 + g3
lsgred(x^4*d^4, H_sub, SG);                 // 0, so x^4 d^4 lies in J
quit;

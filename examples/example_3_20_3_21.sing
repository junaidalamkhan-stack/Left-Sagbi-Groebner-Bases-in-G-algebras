// Examples 3.20 and 3.21: left SG-basis (Algorithm 2, lsgb) in A_1, lex x > d,
// for J = S<x^4 d^2, (xd)^3> in S = Q<x^2, xd, d^2>.
option(noredefine);
LIB "ncsg.lib";
ring R = 0, (x, d), lp;
matrix C[2][2]; C[1,2] = 1;
matrix D[2][2]; D[1,2] = 1;                 // d*x = x*d + 1
def A1 = nc_algebra(C, D);                  // first Weyl algebra
setring A1;
ideal H_sub = x^2, x*d, d^2;                // Sagbi basis of S
ideal G_ideal = x^4*d^2, x^3*d^3 + 3*x^2*d^2 + x*d;
syzfam(G_ideal[1], G_ideal[2], H_sub);      // the syzygies p11, p12 (Table 3)
lsgb(G_ideal, H_sub, 10);
quit;

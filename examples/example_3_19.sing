// Example 3.19: left SG-basis (Algorithm 2, lsgb) in U(sl_2), lex e > f > h,
// for the left ideal generated by g1 = s1*s2 and g2 = s1*s3 in S = Q<e, h^2, eh + e>.
option(noredefine);
LIB "ncsg.lib";
ring R = 0, (e, f, h), lp;
matrix C[3][3]; C[1,2]=1; C[1,3]=1; C[2,3]=1;
matrix D[3][3]; D[1,2]=-h; D[1,3]=2*e; D[2,3]=-2*f;
def Usl2 = nc_algebra(C, D);                // U(sl_2): f*e = e*f - h, h*e = e*h + 2e, h*f = f*h - 2f
setring Usl2;
ideal H_sub = e, h^2, e*h + e;              // Sagbi basis of S
ideal G_ideal = e*h^2, e^2*h + e^2;
syzfam(G_ideal[1], G_ideal[2], H_sub);      // the syzygies p11, p12 (Table 2; p11 up to sign)
lsgb(G_ideal, H_sub, 10);                   // eh2, e2h+e2, e2
quit;

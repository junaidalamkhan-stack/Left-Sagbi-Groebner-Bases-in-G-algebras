// Bounded independent check of left SG-bases (Definition 3.2): all products
// m(H)*g with an H-monomial m(H) of degree <= D and g in G are formed in the
// G-algebra, the leading monomials of their K-span are computed by Gaussian
// elimination, and each is tested for being left SG-reducible by G, i.e.
// LE = mu + LE(g) with g in G and mu in the monoid generated by LE(H).
// A failure proves that G is NOT a left SG-basis of the left ideal it
// generates in S; none up to degree D is evidence (not a proof) that it is.
// The input generators serve as negative controls.
option(noredefine);
LIB "ncsg.lib";
// all H-monomials (words in H) of degree <= D
proc hWords(ideal H, int D)
{
  list W = list(poly(1)); list Wd = list(0); int n = 1; int j;
  while (n <= size(W)) {
    for (j = 1; j <= ncols(H); j++) {
      if (Wd[n] + deg(H[j]) <= D) { W = W + list(W[n] * H[j]); Wd = Wd + list(Wd[n] + deg(H[j])); }
    }
    n++;
  }
  return(W);
}
// is the exponent vector a in the monoid generated by the leading exponents of H?
proc inMonoid(intvec a, ideal H)
{
  intvec y; int i; for (i = 1; i <= ncols(H); i++) { y[i] = 0; }
  list gen_exps; for (i = 1; i <= ncols(H); i++) { gen_exps[i] = leadexp(H[i]); }
  list r = monsrch(a, gen_exps, 1, y);
  return(r[1]);
}
proc sgCheck(ideal G, ideal H, int D)
{
  list W = hWords(H, D); list P; int i; int j; int k; int red;
  for (i = 1; i <= size(W); i++) { for (j = 1; j <= ncols(G); j++) {
    P = P + list(W[i] * G[j]); } }
  list B;
  for (i = 1; i <= size(P); i++) {
    poly p = P[i]; red = 1;
    while (p != 0 && red) { red = 0;
      for (k = 1; k <= size(B); k++) { if (leadmonom(B[k]) == leadmonom(p)) { p = p - leadcoef(p)/leadcoef(B[k]) * B[k]; red = 1; break; } } }
    if (p != 0) { B = B + list(p); }
  }
  int bad = 0; intvec a; intvec b; int ok; int v;
  for (k = 1; k <= size(B); k++) {
    a = leadexp(B[k]); ok = 0;
    for (j = 1; j <= ncols(G) && !ok; j++) {
      b = leadexp(G[j]); intvec c = a - b; int nonneg = 1;
      for (v = 1; v <= size(c); v++) { if (c[v] < 0) { nonneg = 0; } }
      if (nonneg) { ok = inMonoid(c, H); }
    }
    if (!ok) { bad++; if (bad <= 2) { "  not left SG-reducible: leading monomial", leadmonom(B[k]); } }
  }
  "  " + string(size(P)) + " products m(H)*g with deg m(H) <= " + string(D) + ", span of dimension " + string(size(B)) + ", leading monomials not left SG-reducible: " + string(bad);
}
"Example 3.20 (A_1), input generators (negative control):";
ring R = 0, (x, d), lp;
matrix C[2][2]; C[1,2] = 1;
matrix D[2][2]; D[1,2] = 1;                 // d*x = x*d + 1
def A1 = nc_algebra(C, D);                  // first Weyl algebra
setring A1;
ideal H = x^2, x*d, d^2;
ideal G0 = x^4*d^2, x^3*d^3 + 3*x^2*d^2 + x*d;
sgCheck(G0, H, 8);
"Example 3.20 (A_1), output of lsgb:";
sgCheck(lsgb(G0, H, 10), H, 8);

"Example 3.19 (U(sl_2)), input generators (negative control):";
ring R = 0, (e, f, h), lp;
matrix C[3][3]; C[1,2]=1; C[1,3]=1; C[2,3]=1;
matrix D[3][3]; D[1,2]=-h; D[1,3]=2*e; D[2,3]=-2*f;
def Usl2 = nc_algebra(C, D);                // U(sl_2): f*e = e*f - h, h*e = e*h + 2e, h*f = f*h - 2f
setring Usl2;
ideal H = e, h^2, e*h + e;
ideal G0 = e*h^2, e^2*h + e^2;
sgCheck(G0, H, 8);
"Example 3.19 (U(sl_2)), output of lsgb:";
sgCheck(lsgb(G0, H, 10), H, 8);
quit;
